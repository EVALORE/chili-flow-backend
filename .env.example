NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-local-development-secret
AUTH_TRANSPORT=both
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chili_flow?schema=public
UPLOADS_DIR=./uploads
PUBLIC_BACKEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5173,http://127.0.0.1:5173
JAMENDO_CLIENT_ID=replace-with-jamendo-client-id
JAMENDO_API_BASE_URL=https://api.jamendo.com/v3.0
JAMENDO_CLIENT_SECRET=
JAMENDO_REDIRECT_URI=
CATALOG_RATE_LIMIT_WINDOW_SECONDS=60
CATALOG_RATE_LIMIT_MAX_REQUESTS=120
CATALOG_CACHE_TTL_SECONDS=60
CATALOG_CACHE_MAX_ENTRIES=500
